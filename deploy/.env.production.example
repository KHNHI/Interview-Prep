# Copy this to `/opt/interviewprep/.env` on the EC2 box and fill in real values.
# NEVER commit the filled-in version. chmod 600 it after creating.

# The exact image ref the deploy publishes to ECR (the deploy workflow keeps
# `:latest` updated; pinning a SHA tag is safer if you prefer explicit rollbacks).
ECR_IMAGE=1234567890.dkr.ecr.ap-southeast-1.amazonaws.com/interviewprep-api:latest

# ── App config (double underscore __ maps to nested JSON config keys) ────────
ASPNETCORE_ENVIRONMENT=Production

# RDS PostgreSQL endpoint (NOT the docker postgres). SSL is required by RDS.
ConnectionStrings__DefaultConnection=Host=YOUR-DB.xxxxxx.ap-southeast-1.rds.amazonaws.com;Port=5432;Database=interview_platform;Username=appuser;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# Redis runs in the same compose network.
ConnectionStrings__Redis=redis:6379

# Generate a strong secret: `openssl rand -base64 48`
Jwt__Secret=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING
Jwt__Issuer=https://api.lazyndev.io.vn
Jwt__Audience=interview-platform
Jwt__ExpiresInMinutes=60

Stripe__SecretKey=sk_live_xxx
Stripe__WebhookSecret=whsec_xxx

Anthropic__ApiKey=sk-ant-xxx

# Comma-separated list of allowed browser origins (your CloudFront domains).
AllowedOrigins=https://lazyndev.io.vn,https://www.lazyndev.io.vn

# ── Email (verification links) ───────────────────────────────────────────────
# Email__Provider: "smtp" (Brevo/SendGrid/Gmail), "ses" (Amazon SES), or
# anything else = console (local dev; logs the link).
Email__Provider=smtp
Email__FromAddress=noreply@lazyndev.io.vn
Email__FromName=InterviewPrep
# Base URL used to build the verification link in the email.
App__FrontendBaseUrl=https://lazyndev.io.vn

# --- SMTP provider (used when Email__Provider=smtp) --------------------------
# Brevo example (free 300/day). Get these from Brevo → SMTP & API → SMTP.
Email__Smtp__Host=smtp-relay.brevo.com
Email__Smtp__Port=587
Email__Smtp__User=your-brevo-login@example.com
Email__Smtp__Password=YOUR_BREVO_SMTP_KEY

# --- Amazon SES (used when Email__Provider=ses) ------------------------------
# AWS__Region=ap-southeast-2
